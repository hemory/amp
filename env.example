# ===================
# Amp Environment Variables
# ===================
# Copy this file to .env and fill in your values.
# None of these are required for core functionality.
# They enable optional integrations.

# Vault path (auto-set by install.sh)
VAULT_PATH=

# Slack Bot (optional - enables mobile access)
# Create a Slack app: https://api.slack.com/apps
SLACK_BOT_TOKEN=
SLACK_APP_TOKEN=

# Google Workspace (optional - enables Gmail, Calendar, Docs)
# See docs/integrations/google-workspace.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Granola (optional - meeting transcription)
GRANOLA_API_KEY=
